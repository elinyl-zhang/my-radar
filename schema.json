{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radar-daily-feed-v2",
  "title": "My Radar — Daily Feed (v2)",
  "description": "One day's issue of My Radar: signals plotted against four intellectual territories, one emerging pattern, one open question, and six editorial windows. The page is rendered from this file alone — there is no AI call at runtime.",
  "type": "object",
  "required": ["date", "territories", "signals", "pattern", "open_question", "editorial"],
  "properties": {
    "$schema": { "type": "string", "const": "radar-daily-feed-v2" },
    "date": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 date of this issue (YYYY-MM-DD)."
    },
    "territories": {
      "type": "array",
      "description": "The four fixed intellectual territories. These stay stable over time — what moves is where signals land inside them.",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/territory" }
    },
    "signals": {
      "type": "array",
      "description": "Today's signals. Each is a real artefact (paper, tool, study, person) plus a written account of why it is on the radar at all.",
      "minItems": 1,
      "items": { "$ref": "#/$defs/signal" }
    },
    "pattern": {
      "$ref": "#/$defs/pattern",
      "description": "The cross-signal pattern of the day. One signal is news; several unrelated teams converging is a pattern."
    },
    "open_question": {
      "$ref": "#/$defs/open_question",
      "description": "One unresolved question to carry out of the issue. Deliberately left unanswered."
    },
    "editorial": { "$ref": "#/$defs/editorial" }
  },
  "$defs": {
    "territory": {
      "type": "object",
      "required": ["name", "x", "y"],
      "properties": {
        "name": { "type": "string", "description": "Display name, e.g. 'AI SYSTEMS'." },
        "x": { "type": "number", "description": "Horizontal position on the landscape plot." },
        "y": { "type": "number", "description": "Vertical position on the landscape plot." }
      }
    },
    "signal": {
      "type": "object",
      "required": [
        "id", "headline", "one_liner", "signal_type", "chain", "why_you",
        "title", "source", "url", "date", "summary",
        "why_it_matters", "why_you_should_care",
        "radar_score", "domains", "connections",
        "suggested_action", "landscape"
      ],
      "properties": {
        "id": { "type": "string", "description": "Short stable id within the issue, e.g. 's1'." },
        "headline": { "type": "string", "description": "Editorial headline written for this reader, not the source's own title." },
        "one_liner": { "type": "string", "description": "One sentence: what this actually is." },
        "signal_type": {
          "type": "string",
          "enum": ["NOW", "LEARN", "OPPORTUNITY"],
          "description": "NOW = it happened; LEARN = worth understanding; OPPORTUNITY = you could act on it."
        },
        "chain": {
          "type": "string",
          "description": "The territory-to-territory connection this signal makes, e.g. 'AI SYSTEMS → HUMAN COGNITION'. A signal that connects no second territory is usually not worth publishing."
        },
        "why_you": { "type": "string", "description": "Why this lands on this specific reader's radar, addressed in the second person." },
        "title": { "type": "string", "description": "Original title of the source artefact." },
        "source": { "type": "string", "description": "Publication or venue, e.g. 'arXiv (cs.CL)'." },
        "url": { "type": "string", "format": "uri", "description": "Canonical link to the source." },
        "date": { "type": "string", "format": "date", "description": "Publication date of the source." },
        "summary": { "type": "string", "description": "Factual summary of the source. No editorialising here." },
        "why_it_matters": { "type": "string", "description": "Why the field should care." },
        "why_you_should_care": { "type": "string", "description": "Why this reader should care, tied to an active project or growth edge." },
        "radar_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Relevance score for this reader. Drives ordering and visual weight."
        },
        "domains": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Territories this signal touches."
        },
        "connections": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicit links to other signals, projects, or prior issues."
        },
        "suggested_action": {
          "type": "string",
          "description": "One concrete next step. Vague actions ('read more') are rejected by the protocol."
        },
        "landscape": {
          "type": "object",
          "description": "Where the signal sits on the territory plot.",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        }
      }
    },
    "pattern": {
      "type": "object",
      "required": ["label", "statement"],
      "properties": {
        "label": { "type": "string", "description": "Short label, e.g. 'PATTERN EMERGING'." },
        "statement": { "type": "string", "description": "The synthesis: what several unrelated sources converged on this week." }
      }
    },
    "open_question": {
      "type": "object",
      "required": ["label", "text"],
      "properties": {
        "label": { "type": "string", "description": "Short label, e.g. 'A QUESTION WORTH CARRYING'." },
        "text": { "type": "string", "description": "The question itself. Must be genuinely open." }
      }
    },
    "editorial": {
      "type": "object",
      "description": "The six editorial windows. Same shape every day, different content.",
      "required": ["world", "think", "look", "discover", "explore", "make"],
      "properties": {
        "world": {
          "type": "array",
          "description": "What happened. Intelligence briefing.",
          "items": {
            "type": "object",
            "required": ["headline", "sub", "why", "source_url", "source_name"],
            "properties": {
              "headline": { "type": "string" },
              "sub": { "type": "string" },
              "why": { "type": "string" },
              "source_url": { "type": "string", "format": "uri" },
              "source_name": { "type": "string" }
            }
          }
        },
        "think": {
          "type": "array",
          "description": "What idea is worth carrying.",
          "items": {
            "type": "object",
            "required": ["concept", "question", "explain", "why", "source_url"],
            "properties": {
              "concept": { "type": "string" },
              "question": { "type": "string" },
              "explain": { "type": "string" },
              "why": { "type": "string" },
              "source_url": { "type": "string", "format": "uri" }
            }
          }
        },
        "look": {
          "type": "object",
          "description": "Aesthetic training — one thing to look at closely.",
          "required": ["subject", "look_for", "visit_url", "visit_name", "image_url"],
          "properties": {
            "subject": { "type": "string" },
            "look_for": { "type": "string" },
            "visit_url": { "type": "string", "format": "uri" },
            "visit_name": { "type": "string" },
            "image_url": { "type": "string", "format": "uri" }
          }
        },
        "discover": {
          "type": "object",
          "description": "One person who should enter this reader's world.",
          "required": ["name", "roles", "desc", "why", "tags", "link_url"],
          "properties": {
            "name": { "type": "string" },
            "roles": { "type": "string" },
            "desc": { "type": "string" },
            "why": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "link_url": { "type": "string", "format": "uri" }
          }
        },
        "explore": {
          "type": "object",
          "description": "One rabbit hole worth following.",
          "required": ["question", "start_url", "start_name", "trail", "why"],
          "properties": {
            "question": { "type": "string" },
            "start_url": { "type": "string", "format": "uri" },
            "start_name": { "type": "string" },
            "trail": { "type": "array", "items": { "type": "string" } },
            "why": { "type": "string" }
          }
        },
        "make": {
          "type": "object",
          "description": "One tool, framed by the situation it is useful in.",
          "required": ["tool", "does", "why", "try", "link_url"],
          "properties": {
            "tool": { "type": "string" },
            "does": { "type": "string" },
            "why": { "type": "string" },
            "try": { "type": "string" },
            "link_url": { "type": "string", "format": "uri" }
          }
        }
      }
    }
  }
}
